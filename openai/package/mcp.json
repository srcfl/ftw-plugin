{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ftw-cloud": {
      "type": "streamable-http",
      "url": "https://cloud.ftw.energy/mcp?profile=public",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "ftw.live.read",
              "ftw.plan.read",
              "ftw.history.read",
              "ftw.health.read"
            ],
            "defaultScopes": [
              "ftw.live.read",
              "ftw.plan.read",
              "ftw.history.read",
              "ftw.health.read"
            ]
          }
        }
      }
    }
  }
}
